# Dominio viejo y www → praxiagestion.com.ar (301), conservando la ruta.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(praxiaweb\.manuchoit\.com\.ar|www\.praxiagestion\.com\.ar)$ [NC]
  RewriteRule ^(.*)$ https://praxiagestion.com.ar/$1 [R=301,L]
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Caché del navegador. También rige para public_html/app (la app): su HTML
# no se cachea y sus JS/CSS cambian de nombre en cada versión.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

DirectoryIndex index.html

# Estado del deploy por FTP (.github/workflows/deploy.yml): no se sirve.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
